{
  "name": "@chatbotui/agent-chatbot-ui",
  "version": "0.1.5",
  "description": "Agent Chatbot UI components based on ant-design-x-vue with 5-step execution lifecycle, HITL interactions, and streaming support",
  "main": "./dist/agent-chatbot-ui.umd.cjs",
  "module": "./dist/agent-chatbot-ui.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/agent-chatbot-ui.js",
      "require": "./dist/agent-chatbot-ui.umd.cjs"
    },
    "./examples": "./examples/index.html",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly",
    "lint": "vue-tsc --noEmit",
    "preview": "vite preview",
    "release:check": "node -e \"if (!process.env.NPM_TOKEN) { console.error('Missing NPM_TOKEN'); process.exit(1); } console.log('NPM_TOKEN is set');\"",
    "release:verify": "npm whoami && npm config get registry"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "ant-design-vue": "^4.0.0",
    "ant-design-x-vue": "^1.6.0",
    "marked": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "ant-design-vue": "^4.0.0",
    "ant-design-x-vue": "^1.6.0",
    "marked": "^9.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "vue",
    "chatbot",
    "agent",
    "ant-design",
    "ant-design-x",
    "chat-ui",
    "llm",
    "stream"
  ],
  "author": "OpenDataCo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opendataco/agent-chatbot-ui"
  }
}
